# ─── Google GenAI (Official) ────────────────────────────────
# Used for: gemma-4-26b-a4b-it (main agent) + gemma-4-2b-it (title/OM)
GOOGLE_GENERATIVE_AI_API_KEY=

# ─── GitHub MCP Server ──────────────────────────────────────
# Used for: @modelcontextprotocol/server-github MCP integration
GITHUB_PERSONAL_ACCESS_TOKEN=

# ─── Tavily Web Search ───────────────────────────────────────
# Used for: search_web tool via @tavily/core
TAVILY_API_KEY=

# ─── Mastra Server (auto-configured at runtime) ─────────────
# Port is dynamic — set only to force a specific port
MASTRA_SERVER_PORT=

# ─── OTEL (optional dev observability) ──────────────────────
OTEL_SERVICE_NAME=orch-code
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ─── App ────────────────────────────────────────────────────
NODE_ENV=development
