{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "renderer/env.d.ts",
    "renderer/**/*",
    "renderer/**/*.tsx",
    "preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "renderer/*"
      ]
    },
    "resolveJsonModule": true,
    "moduleResolution": "bundler"
  }
}
