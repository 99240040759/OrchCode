{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "renderer/env.d.ts",
    "renderer/**/*",
    "renderer/**/*.tsx",
    "preload/*.d.ts",
    "shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@renderer/*": ["renderer/*"],
      "@/*": ["renderer/*"]
    }
  }
}
