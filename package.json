    "react-resizable-panels": "^2.1.9",
    "react-virtuoso": "^4.18.7",
    "rehype-highlight": "^7.0.2",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.1",
    "sonner": "^2.0.7",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
