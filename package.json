{
  "name": "orch-code",
  "productName": "Orch Code",
  "version": "1.0.0",
  "description": "Orch Code - AI-powered agentic code editor",
  "main": "./out/main/index.js",
  "author": "Orch",
  "homepage": "https://orch.live",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "knip": "knip",
    "jscpd": "jscpd main renderer preload",
    "code-audit": "npm run knip && npm run jscpd",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && node scripts/copy-wasms.js && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@sentry/electron": "^7.13.0",
    "@vscode/ripgrep": "^1.18.0",
    "better-sqlite3": "^12.10.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "node-pty": "^1.1.0",
    "web-tree-sitter": "^0.26.9"
  },
  "devDependencies": {
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/openai": "^3.0.68",
    "@ai-sdk/provider-utils": "^4.0.27",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@radix-ui/react-tabs": "^1.1.14",
    "@react-symbols/icons": "^1.4.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/lodash.debounce": "^4.0.9",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/shell-quote": "^1.7.5",
    "@vitejs/plugin-react": "^5.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.198",
    "babel-plugin-react-compiler": "^1.0.0",
    "bottleneck": "^2.19.5",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "electron": "^39.2.6",
    "electron-builder": "^26.15.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "highlight.js": "^11.11.1",
    "ignore": "^7.0.5",
    "jotai": "^2.20.0",
    "jscpd": "^5.0.5",
    "katex": "^0.17.0",
    "knip": "^6.16.1",
    "lodash.debounce": "^4.0.8",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.15.0",
    "mime-types": "^3.0.2",
    "prettier": "^3.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shell-quote": "^1.8.4",
    "sonner": "^2.0.7",
    "tree-sitter-wasms": "^0.1.13",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "zod": "^4.4.3"
  }
}
