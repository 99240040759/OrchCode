{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "electron.vite.config.ts",
    "main/main.ts",
    "main/agentWorker.ts",
    "preload/index.ts",
    "renderer/main.tsx"
  ],
  "project": ["main/**/*.ts", "preload/**/*.ts", "renderer/**/*.{ts,tsx}"],
  "ignore": ["**/*.d.ts"],
  "paths": {
    "@renderer/*": ["renderer/*"]
  },
  "ignoreDependencies": ["babel-plugin-react-compiler"]
}

