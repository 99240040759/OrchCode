{
  "name": "gcp-api-function",
  "version": "0.0.1",
  "main": "index.js",
  "dependencies": {
    "@google-cloud/functions-framework": "^3.4.2",
    "@google-cloud/storage": "^7.21.0",
    "@google/genai": "^2.11.0",
    "@octokit/rest": "^22.0.1",
    "@tavily/core": "^0.7.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "firebase-admin": "^12.7.0",
    "groq-sdk": "^1.3.0",
    "mime-types": "^3.0.2",
    "tar": "^7.5.20"
  },
  "scripts": {
    "start": "npx @google-cloud/functions-framework --target=api",
    "deploy": "gcloud functions deploy api --runtime=nodejs22 --trigger-http --allow-unauthenticated --env-vars-file=.env.yaml --region=us-central1 --concurrency=1 --timeout=540 --memory=256Mi"
  }
}
