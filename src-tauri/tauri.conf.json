{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orch Code",
  "version": "0.1.0",
  "identifier": "com.orchcode.desktop",
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "build": {
    "frontendDist": "../src-ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd src-ui && npm run dev",
    "beforeBuildCommand": "cd src-ui && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orch Code",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "maxWidth": 4096,
        "maxHeight": 2160,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "tabbingIdentifier": "orchcode_main",
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": { "open": true },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxRkFFQTk5MDRGMzc5NTEKUldSUmVmTUVtZXI2NGROUTkvVklKbjFLdzZUZEJVRjhkbDZQczRhZkxlRm1ON0tDMGg4RllGN3EK",
      "endpoints": [
        "https://github.com/sameer786ss/OrchCode/releases/latest/download/latest.json"
      ]
    },
    "window-state": null
  }
}
