# Local build-time config — real values must never be committed.
# Injected into the binary at compile time (src-tauri/build.rs) and, in CI,
# from GitHub repo secrets (see .github/workflows/build-release.yml).
.env
.env.*
!.env.example

# Tauri updater signing keys — never commit.
*.key
*.key.pub

